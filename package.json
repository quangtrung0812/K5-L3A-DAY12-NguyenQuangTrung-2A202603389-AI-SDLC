{
  "name": "dao-den-long",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:headless": "tsc -p tsconfig.headless.json",
    "build:web": "vite build",
    "build": "npm run build:headless && npm run build:web",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
