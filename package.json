{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:headless": "tsc -p tsconfig.headless.json",
    "build:web": "vite build",
    "build": "npm run build:headless && npm run build:web",
    "start": "node scripts/run.mjs",
    "preview": "node scripts/run.mjs",
    "bench": "node scripts/bench.mjs --seed 42 --duration 30 --out bench.json",
    "soak": "node --max-semi-space-size=1 --expose-gc dist/headless/headless/soak.js --seed 7 --nights 10 --out soak.json",
    "package:release": "node scripts/package-release.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "verify:contract": "node scripts/verify-contract.mjs",
    "test": "npm run typecheck && npm run build:headless && npm run test:unit && npm run verify:contract"
  },
  "dependencies": {
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/three": "^0.174.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
