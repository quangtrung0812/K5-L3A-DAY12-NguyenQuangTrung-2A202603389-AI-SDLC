    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/three": "^0.174.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
